/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica3 -c practica3 --vector_source="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/Waveform1.vwf" --testbench_file="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/simulation/qsim/Waveform1.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica3 -c practica3 --vector_source="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/Waveform1.vwf" --testbench_file="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/simulation/qsim/Waveform1.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/simulation/qsim/" practica3 -c practica3</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="/home/ivan/Documents/FI/Lab_oac/practica3/practica3/simulation/qsim/" practica3 -c practica3</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work practica3.vho
vcom -work work Waveform1.vwf.vht
vsim -novopt -c -t 1ps -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica3_vhd_vec_tst
vcd file -direction practica3.msim.vcd
vcd add -internal practica3_vhd_vec_tst/*
vcd add -internal practica3_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work practica3.vho
vcom -work work Waveform1.vwf.vht
vsim -novopt -c -t 1ps -sdfmax practica3_vhd_vec_tst/i1=practica3_vhd.sdo -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica3_vhd_vec_tst
vcd file -direction practica3.msim.vcd
vcd add -internal practica3_vhd_vec_tst/*
vcd add -internal practica3_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
