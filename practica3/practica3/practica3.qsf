set_location_assignment PIN_C10 -to reset
set_location_assignment PIN_D12 -to entradas[1]
set_location_assignment PIN_C12 -to entradas[2]
set_location_assignment PIN_A8 -to edo_p[0]
set_location_assignment PIN_A9 -to edo_p[1]
set_location_assignment PIN_A10 -to edo_p[2]
set_location_assignment PIN_D13 -to VBPM[0]
set_location_assignment PIN_C13 -to VBPM[1]
set_location_assignment PIN_E14 -to VBPM[2]
set_location_assignment PIN_D14 -to VBPM[3]
