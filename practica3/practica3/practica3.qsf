set_global_assignment -name BDF_FILE practica3.bdf
set_global_assignment -name VHDL_FILE registro.vhd
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VHDL_FILE concatenador.vhd
set_global_assignment -name VHDL_FILE rom.vhd
set_global_assignment -name VHDL_FILE div_datos.vhd
set_global_assignment -name VHDL_FILE clk_buttom.vhd
set_location_assignment PIN_P11 -to clk
