library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity muxDireccion is
    Port (
        sel : in  std_logic; -- 0: continuar; 1: tomar direccion de salto
        E0  : in  std_logic_vector(3 downto 0); -- MPC + 1
        E1  : in  std_logic_vector(3 downto 0); -- destino de salto ya seleccionado
        sal : out std_logic_vector(3 downto 0)  -- siguiente direccion del MPC
    );
end muxDireccion;

architecture Behavioral of muxDireccion is
begin
    process(sel, E0, E1)
    begin
        -- Valor seguro para estados no binarios de sel.
        sal <= E0;
        if sel = '1' then
            sal <= E1;
        end if;
    end process;
end Behavioral;
