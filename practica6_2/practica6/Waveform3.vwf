/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica6 -c practica6_sim --vector_source="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/Waveform_sim.vwf" --testbench_file="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/simulation/qsim_sim/Waveform_sim.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica6 -c practica6_sim --vector_source="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/Waveform_sim.vwf" --testbench_file="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/simulation/qsim_sim/Waveform_sim.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/simulation/qsim_sim/" practica6 -c practica6_sim</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="/home/ivan/Documents/FI/Lab_oac/practica6_2/practica6/simulation/qsim_sim/" practica6 -c practica6_sim</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work practica6_sim.vho
vcom -work work Waveform_sim.vwf.vht
vsim -novopt -c -t 1ps -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica6_sim_vhd_vec_tst
vcd file -direction practica6_sim.msim.vcd
vcd add -internal practica6_sim_vhd_vec_tst/*
vcd add -internal practica6_sim_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work practica6_sim.vho
vcom -work work Waveform_sim.vwf.vht
vsim -novopt -c -t 1ps -sdfmax practica6_sim_vhd_vec_tst/i1=practica6_sim_vhd.sdo -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica6_sim_vhd_vec_tst
vcd file -direction practica6_sim.msim.vcd
vcd add -internal practica6_sim_vhd_vec_tst/*
vcd add -internal practica6_sim_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
